# StatPitch - Environment Variables Example
# Duplicate this file, rename to .env.local, and fill in the values.

# Supabase (Get these from your Supabase project settings)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# API-Football (api-football.com / RapidAPI)
API_FOOTBALL_KEY=your_api_football_key

# ScraperAPI (Proxy para bypassar Cloudflare - scraperapi.com)
SCRAPER_API_KEY=your_scraper_api_key

# Cron Job Security (Choose a secure random string)
CRON_SECRET=your_cron_bearer_token_here
